{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aspace.business.capability.v1",
  "type": "object",
  "required": [
    "capability_id",
    "version",
    "domain_owner",
    "intent",
    "effect_class",
    "input_schema",
    "output_schema",
    "preconditions",
    "authority",
    "deterministic_validation",
    "side_effects",
    "idempotency",
    "compensation",
    "evidence_required",
    "freshness",
    "supported_surfaces",
    "runtime_bindings",
    "effect_receipt"
  ],
  "properties": {
    "capability_id": { "type": "string" },
    "version": { "type": "string" },
    "domain_owner": { "type": "string" },
    "intent": { "type": "string" },
    "effect_class": { "enum": ["COMMAND", "QUERY", "EVENT"] },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "authority": { "type": "string" },
    "deterministic_validation": { "type": "array", "items": { "type": "string" } },
    "side_effects": { "type": "array", "items": { "type": "string" } },
    "idempotency": { "type": "boolean" },
    "compensation": { "type": "string" },
    "evidence_required": { "type": "boolean" },
    "freshness": { "type": "string" },
    "supported_surfaces": { "type": "array", "items": { "type": "string" } },
    "runtime_bindings": { "type": "array", "items": { "type": "string" } },
    "effect_receipt": { "type": "object" }
  }
}
