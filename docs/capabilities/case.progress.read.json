{
  "capability_id": "case.progress.read",
  "version": "1.0",
  "domain_owner": "Business OS",
  "intent": "Read the current progress status of a case",
  "effect_class": "QUERY",
  "input_schema": {
    "type": "object",
    "properties": {
      "case_id": { "type": "string" }
    },
    "required": ["case_id"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "case_id": { "type": "string" },
      "status": { "type": "string" },
      "progress_percentage": { "type": "integer" },
      "last_updated": { "type": "string", "format": "date-time" }
    }
  },
  "preconditions": [
    "Case exists"
  ],
  "authority": "business:read",
  "deterministic_validation": [
    "case_id format is valid"
  ],
  "side_effects": [],
  "idempotency": true,
  "compensation": "",
  "evidence_required": false,
  "freshness": "eventual",
  "supported_surfaces": ["api", "mobile", "in_app"],
  "runtime_bindings": ["python", "nodejs"],
  "effect_receipt": {
    "type": "object",
    "properties": {}
  }
}
